---
/**
 * The form for one session, news post, board member or partner, built from
 * the field list in src/lib/admin/collections.ts.
 */
import { repoPathOfImage, type Collection, type Field, type Values } from "../../lib/admin/collections";
import { ACCEPT } from "../../lib/admin/images";

interface Props {
  collection: Collection;
  values: Values;
  errors: Record<string, string>;
  submitLabel: string;
  /** Version of the file being edited; sent back so a stale save is refused. */
  sha?: string;
  /** Choices for `reference` fields, by collection. */
  refOptions?: Record<string, { value: string; label: string }[]>;
  /** Photos chosen on a save that failed, as data: URLs, so they need not be chosen again. */
  kept?: Record<string, string>;
}

const { collection: c, values, errors, submitLabel, sha, refOptions = {}, kept = {} } = Astro.props;

/* Fields in their groups, in the order the groups first appear. */
const groups: { title: string; fields: (Field | "body")[] }[] = [];
const groupFor = (title: string) => {
  let g = groups.find((x) => x.title === title);
  if (!g) groups.push((g = { title, fields: [] }));
  return g;
};
for (const f of c.fields) groupFor(f.group).fields.push(f);
if (c.body) groupFor(c.body.group).fields.push("body");
groupFor("Publishing");

const input =
  "mt-1 block w-full rounded border border-line bg-white px-3 py-2 text-base text-ink focus:border-deep focus:outline-none focus:ring-2 focus:ring-deep-050";
const label = "block font-semibold text-ink";
const hint = "mt-1 text-sm text-ink-muted";
const err = "mt-1 text-sm font-semibold text-[#B42318]";
const describedBy = (name: string, hasHint: boolean) =>
  [hasHint ? `${name}-hint` : "", errors[name] ? `${name}-error` : ""].filter(Boolean).join(" ") || undefined;
const picked = (name: string) => new Set((values[name] ?? "").split("\n").filter(Boolean));
---

<form method="post" enctype="multipart/form-data" class="grid gap-6" novalidate>
  <input type="hidden" name="action" value="save" />
  {sha && <input type="hidden" name="sha" value={sha} />}

  {
    errors.form ? (
      <p role="alert" class="rounded border border-[#B42318] bg-white p-3 font-semibold text-[#B42318]">{errors.form}</p>
    ) : (
      Object.keys(errors).length > 0 && (
        <p role="alert" class="rounded border border-[#B42318] bg-white p-3 font-semibold text-[#B42318]">
          Nothing was saved. Fix the fields marked in red below.
        </p>
      )
    )
  }

  {
    groups.map((g) => (
      <fieldset class="grid gap-5 rounded border border-line bg-white p-5">
        <legend class="px-1 font-display text-lg font-bold text-deep">{g.title}</legend>

        {g.fields.map((f) => {
          if (f === "body") {
            return (
              <div>
                <label for="body" class={label}>
                  {c.body!.label} <span class="font-normal text-ink-muted">(optional)</span>
                </label>
                <textarea id="body" name="body" rows="12" maxlength="20000" class={input} aria-describedby={describedBy("body", true)}>{values.body}</textarea>
                <p id="body-hint" class={hint}>
                  {c.body!.hint} Leave an empty line between paragraphs. A line starting with <code>## </code> becomes a
                  heading, and <code>**words**</code> become bold.
                </p>
                {errors.body && <p id="body-error" class={err}>{errors.body}</p>}
              </div>
            );
          }

          const id = `f-${f.name}`;

          if (f.type === "image") {
            const current = values[f.name];
            const keptPhoto = kept[f.name];
            return (
              <div>
                <p class={label} id={`${id}-label`}>
                  {f.label} <span class="font-normal text-ink-muted">(optional)</span>
                </p>
                <input type="hidden" name={f.name} value={current} />
                {keptPhoto && <input type="hidden" name={`${f.name}__kept`} value={keptPhoto} />}
                <div class="mt-2 flex flex-wrap items-start gap-4">
                  {keptPhoto ? (
                    <img
                      src={keptPhoto}
                      alt="Chosen photo (not saved yet)"
                      class:list={["h-28 rounded border border-line bg-cream", f.kind === "logo" ? "w-auto object-contain p-2" : "w-40 object-cover"]}
                      data-preview-for={id}
                    />
                  ) : current ? (
                    <img
                      src={`/admin/image?p=${encodeURIComponent(repoPathOfImage(current))}`}
                      alt={`Current ${f.label.toLowerCase()}`}
                      class:list={["h-28 rounded border border-line bg-cream", f.kind === "logo" ? "w-auto object-contain p-2" : "w-40 object-cover"]}
                      data-preview-for={id}
                    />
                  ) : (
                    <div class="grid h-28 w-40 place-items-center rounded border-2 border-dashed border-line text-sm text-ink-muted" data-preview-for={id}>
                      No {f.label.toLowerCase()} yet
                    </div>
                  )}
                  <div class="grid gap-2">
                    <label for={id} class="text-sm font-semibold">{current ? "Replace with a new one" : "Choose a photo"}</label>
                    <input id={id} name={`${f.name}__file`} type="file" accept={ACCEPT} data-photo={f.kind ?? "photo"} class="text-sm" aria-describedby={describedBy(f.name, Boolean(f.hint))} />
                    {(current || keptPhoto) && (
                      <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name={`${f.name}__remove`} class="h-4 w-4" /> Remove the {f.label.toLowerCase()}
                      </label>
                    )}
                  </div>
                </div>
                <p id={`${f.name}-hint`} class={hint}>
                  {f.hint} JPG, PNG or WebP. Big photos are shrunk automatically, and hidden location data is removed.
                </p>
                {errors[f.name] && <p id={`${f.name}-error`} class={err}>{errors[f.name]}</p>}
              </div>
            );
          }
          const opt = !f.required && f.type !== "checkbox" && f.type !== "checkboxes";
          const invalid = errors[f.name] ? "true" : undefined;

          if (f.type === "checkbox") {
            return (
              <div class="flex items-start gap-3">
                <input id={id} name={f.name} type="checkbox" checked={values[f.name] === "on"} class="mt-1 h-5 w-5" aria-describedby={describedBy(f.name, Boolean(f.hint))} />
                <div>
                  <label for={id} class={label}>{f.label}</label>
                  {f.hint && <p id={`${f.name}-hint`} class={hint}>{f.hint}</p>}
                  {errors[f.name] && <p id={`${f.name}-error`} class={err}>{errors[f.name]}</p>}
                </div>
              </div>
            );
          }

          if (f.type === "checkboxes") {
            return (
              <fieldset aria-describedby={describedBy(f.name, Boolean(f.hint))}>
                <legend class={label}>{f.label}</legend>
                <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
                  {f.options!.map((o) => (
                    <label class="flex items-center gap-2">
                      <input type="checkbox" name={f.name} value={o.value} checked={picked(f.name).has(o.value)} class="h-5 w-5" />
                      {o.label}
                    </label>
                  ))}
                </div>
                {f.hint && <p id={`${f.name}-hint`} class={hint}>{f.hint}</p>}
                {errors[f.name] && <p id={`${f.name}-error`} class={err}>{errors[f.name]}</p>}
              </fieldset>
            );
          }

          const choices =
            f.type === "select" ? f.options! : f.type === "reference" ? [{ value: "", label: "None" }, ...(refOptions[f.ref!] ?? [])] : null;

          return (
            <div>
              <label for={id} class={label}>
                {f.label} {opt && <span class="font-normal text-ink-muted">(optional)</span>}
              </label>
              {choices ? (
                <select id={id} name={f.name} class={input} aria-describedby={describedBy(f.name, Boolean(f.hint))} aria-invalid={invalid}>
                  {choices.map((o) => <option value={o.value} selected={values[f.name] === o.value}>{o.label}</option>)}
                </select>
              ) : f.type === "textarea" ? (
                <textarea id={id} name={f.name} rows={f.max && f.max > 1000 ? 12 : 3} maxlength={f.max} class={input} aria-describedby={describedBy(f.name, Boolean(f.hint))} aria-invalid={invalid}>{values[f.name]}</textarea>
              ) : (
                <input
                  id={id}
                  name={f.name}
                  type={f.type === "url" ? "url" : f.type === "email" ? "email" : f.type === "date" ? "date" : f.type === "number" ? "number" : "text"}
                  value={values[f.name]}
                  maxlength={f.max}
                  placeholder={f.type === "url" ? "https://" : undefined}
                  class={input}
                  aria-describedby={describedBy(f.name, Boolean(f.hint))}
                  aria-invalid={invalid}
                />
              )}
              {f.hint && <p id={`${f.name}-hint`} class={hint}>{f.hint}</p>}
              {errors[f.name] && <p id={`${f.name}-error`} class={err}>{errors[f.name]}</p>}
            </div>
          );
        })}

        {g.title === "Publishing" && (
          <div>
            <label for="f-editor" class={label}>Your name</label>
            <input id="f-editor" name="editor" value={values.editor} maxlength="60" autocomplete="name" class={input} aria-describedby={describedBy("editor", true)} aria-invalid={errors.editor ? "true" : undefined} />
            <p id="editor-hint" class={hint}>Kept in the change history so the board can see who changed what. Not shown on the website.</p>
            {errors.editor && <p id="editor-error" class={err}>{errors.editor}</p>}
          </div>
        )}
      </fieldset>
    ))
  }

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary">{submitLabel}</button>
    <a href={`/admin/${c.id}/`} class="text-deep underline">Cancel</a>
  </div>
</form>
