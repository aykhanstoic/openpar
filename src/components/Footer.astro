---
import { getCollection } from "astro:content";
import {
  useTranslations,
  footerOrgNav,
  footerInvolvedNav,
  localePath,
  type Locale,
} from "../i18n/ui";
import Buta from "./Buta.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partners = (await getCollection("partners")).sort(
  (a, b) => a.data.order - b.data.order,
);

const year = new Date().getFullYear();
---

<footer class="relative isolate mt-auto overflow-hidden bg-deep text-white/80">
  <Buta
    class="pointer-events-none absolute -bottom-24 -right-16 -z-10 h-[420px] w-auto -rotate-[18deg] text-white/[0.07]"
    stroke={1.8}
  />
  <!-- Newsletter -->
  <section class="border-b border-white/15">
    <div class="wrap section-sm grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow eyebrow-invert text-[1.4rem]">{t.footer.newsletterTitle}</p>
        <p class="mt-3 max-w-[46ch] text-[1.05rem] text-white/80">
          {t.footer.newsletterBody}
        </p>
      </div>

      <form method="dialog" data-inert-form data-message={t.footer.newsletterDisabled} class="grid gap-3">
        <div class="flex flex-col gap-2 sm:flex-row">
          <label class="sr-only" for="nl-email">{t.footer.newsletterPlaceholder}</label>
          <input
            id="nl-email"
            name="email"
            type="email"
            required
            placeholder={t.footer.newsletterPlaceholder}
            class="w-full border border-white/30 bg-white/10 px-4 py-3 text-[0.95rem] text-white placeholder:text-white/45 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/60"
          />
          <button type="submit" class="btn btn-on-dark shrink-0">
            {t.footer.newsletterButton}
          </button>
        </div>

        <label class="flex items-start gap-2.5 text-[0.8rem] text-white/65">
          <input type="checkbox" required class="mt-1 accent-white" />
          <span>{t.footer.newsletterConsent}</span>
        </label>

        <!-- Double opt-in is a requirement from the plan, not a nicety. -->
        <p class="text-[0.78rem] text-white/55">{t.footer.newsletterDoubleOptIn}</p>
        <p data-form-status class="text-[0.82rem] font-semibold text-white" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- Partner strip -->
  {
    partners.length > 0 && (
      <section class="border-b border-white/15">
        <div class="wrap flex flex-wrap items-center gap-x-10 gap-y-5 py-7">
          <span class="font-display text-[0.95rem] font-bold text-white/60">
            {t.home.partnersEyebrow}
          </span>
          {partners.map((p) => (
            <span class="text-[0.95rem] font-medium text-white/75">{p.data.name}</span>
          ))}
        </div>
      </section>
    )
  }

  <!-- Link columns -->
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.7fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-[1.3rem] font-bold leading-tight text-white">{t.site.name}</p>
      <div class="rule-amber mt-4"></div>
      <p class="mt-3 max-w-[38ch] text-[1rem] leading-relaxed text-white/75">
        {t.footer.about}
      </p>
    </div>

    <div>
      <h2 class="font-display text-[1.05rem] font-bold text-white">
        {t.footer.orgTitle}
      </h2>
      <ul class="mt-4 grid gap-2.5 text-[1rem]">
        {footerOrgNav.map((item) => (
          <li>
            <a href={localePath(locale, item.path)} class="text-white/75 hover:text-white">
              {t.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-display text-[1.05rem] font-bold text-white">
        {t.footer.involvedTitle}
      </h2>
      <ul class="mt-4 grid gap-2.5 text-[1rem]">
        {footerInvolvedNav.map((item) => (
          <li>
            <a href={localePath(locale, item.path)} class="text-white/75 hover:text-white">
              {t.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-display text-[1.05rem] font-bold text-white">
        {t.footer.networkTitle}
      </h2>
      <ul class="mt-4 grid gap-2.5 text-[1rem]">
        <li>
          <a href="https://eyp.org" target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white">
            {t.footer.eypInternational}
          </a>
        </li>
        <li>
          <a href="https://schwarzkopf-stiftung.de" target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white">
            {t.footer.schwarzkopf}
          </a>
        </li>
        <li>
          <a href={localePath(locale, "privacy")} class="text-white/75 hover:text-white">
            {t.nav.privacy}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="wrap flex flex-wrap justify-between gap-3 py-6 text-[0.78rem] text-white/55">
      <span>&copy; {year} {t.site.name}. {t.footer.rights}</span>
      <span>{t.footer.builtBy}</span>
    </div>
  </div>
</footer>

<script>
  /* Every form on this site is intentionally inert: there is no backend, and
     the privacy policy that would have to cover one does not exist yet.
     Intercept submit so the page never looks broken. */
  document.querySelectorAll<HTMLFormElement>("form[data-inert-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      if (status) status.textContent = status.dataset.message ?? form.dataset.message ?? "";
    });
  });
</script>
