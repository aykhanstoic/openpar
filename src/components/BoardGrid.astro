---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  body: "executive" | "supervisory";
  emptyMessage: string;
}

const { locale, body, emptyMessage } = Astro.props;
const t = useTranslations(locale);

const members = (await getCollection("board", (entry) => entry.data.group === body)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Initials stand in until real headshots exist. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");
---

{
  members.length === 0 ? (
    <p class="max-w-[52ch] text-[1rem] text-ink-muted">{emptyMessage}</p>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {members.map((member) => (
        <article class="card card-hover overflow-hidden">
          {member.data.photo ? (
            <Image
              src={member.data.photo}
              alt={member.data.name}
              widths={[240, 480]}
              sizes="(min-width: 1024px) 260px, 45vw"
              class="aspect-square w-full object-cover"
            />
          ) : (
            <div
              class="grid aspect-square w-full place-items-center bg-deep font-display text-[2.2rem] font-bold text-white/90"
              aria-hidden="true"
            >
              {initials(member.data.name)}
            </div>
          )}

          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-display text-[1.02rem] font-bold leading-tight">{member.data.name}</h3>
            <p class="mt-1 text-[0.86rem] text-ink-muted">
              {locale === "az" && member.data.roleAz ? member.data.roleAz : member.data.role}
            </p>

            {member.data.term && (
              <p class="mt-1.5 text-[0.76rem] text-ink-muted">
                {t.boards.termLabel}: {member.data.term}
              </p>
            )}

            {member.data.email && (
              <a
                href={`mailto:${member.data.email}`}
                class="mt-3 break-all text-[0.8rem] text-deep hover:underline"
              >
                {member.data.email}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  )
}
