---
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "../i18n/ui";
import { boardMembers, type BoardBody } from "../lib/board";
import type { DepartmentMember } from "../lib/departments";

/* Either a board (looked up here) or a list given ready-made, such as one
   department's members. Both use the same cards. */
type Props = { locale: Locale; emptyMessage: string } & (
  | { body: BoardBody; /** A past board's year; the current board when left out. */ year?: number; members?: never }
  | { members: DepartmentMember[]; body?: never; year?: never }
);

const { locale, body, emptyMessage, year } = Astro.props;
const t = useTranslations(locale);

const members: { data: { name: string; role: string; roleAz?: string; email?: string; photo?: ImageMetadata; linkedin?: string; term?: string } }[] =
  Astro.props.members ?? (await boardMembers(body!, year));

/** Initials stand in until real headshots exist. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");
---

{
  members.length === 0 ? (
    <p class="max-w-[52ch] text-[1rem] text-ink-muted">{emptyMessage}</p>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {members.map((member) => (
        <article class="card card-hover overflow-hidden">
          <div class="relative">
          {member.data.photo ? (
            <Image
              src={member.data.photo}
              alt={member.data.name}
              widths={[240, 480]}
              sizes="(min-width: 1024px) 260px, 45vw"
              class="aspect-square w-full object-cover"
            />
          ) : (
            <div
              class="grid aspect-square w-full place-items-center bg-deep font-display text-[2.2rem] font-bold text-white/90"
              aria-hidden="true"
            >
              {initials(member.data.name)}
            </div>
          )}

          {/* LinkedIn: a small badge on the photo's corner that opens the profile. */}
          {member.data.linkedin && (
            <a
              href={member.data.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${member.data.name}: ${t.boards.linkedinLabel}`}
              title={t.boards.linkedinLabel}
              class="linkedin-badge"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
              </svg>
            </a>
          )}
          </div>

          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-display text-[1.02rem] font-bold leading-tight">{member.data.name}</h3>
            <p class="mt-1 text-[0.86rem] text-ink-muted">
              {locale === "az" && member.data.roleAz ? member.data.roleAz : member.data.role}
            </p>

            {member.data.term && (
              <p class="mt-1.5 text-[0.76rem] text-ink-muted">
                {t.boards.termLabel}: {member.data.term}
              </p>
            )}

            {member.data.email && (
              <a
                href={`mailto:${member.data.email}`}
                class="mt-3 break-all text-[0.8rem] text-deep hover:underline"
              >
                {member.data.email}
              </a>
            )}

          </div>
        </article>
      ))}
    </div>
  )
}

<style>
  /* LinkedIn badge: LinkedIn blue, bottom-right of the photo, big enough
     to tap (40px). It lifts slightly on hover, like the cards. */
  .linkedin-badge {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 4px;
    background: #0a66c2;
    color: #fff;
    /* White ring keeps it visible on any photo or the indigo placeholder. */
    box-shadow: 0 0 0 2px #fff, 0 4px 12px -4px rgb(0 0 0 / 0.35);
    transition: transform 0.15s, background-color 0.15s;
  }
  .linkedin-badge:hover {
    background: #004182;
    transform: translateY(-2px);
  }
  .linkedin-badge:focus-visible {
    outline: 3px solid var(--color-sun);
    outline-offset: 2px;
  }
</style>
