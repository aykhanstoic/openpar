---
/**
 * The EYP stars, drifting into the pattern of the logo along the bottom of
 * the home hero. Decorative: pure SVG and CSS (see .hero-star in global.css),
 * no script and no image file. Each star is positioned by an outer <g>, and
 * its inner <path> animates, so the two transforms never fight. The CSP
 * forbids inline style="", so delays come from the d0 to d7 classes.
 */
const star = "M0.00 -10.00L2.59 -3.56L9.51 -3.09L4.18 1.36L5.88 8.09L0.00 4.40L-5.88 8.09L-4.18 1.36L-9.51 -3.09L-2.59 -3.56Z";
---

<svg
  class="pointer-events-none absolute inset-x-0 bottom-0 -z-[1] h-auto w-full"
  viewBox="0 0 1440 480"
  aria-hidden="true"
  focusable="false"
>
    <g transform="translate(40 340) rotate(-10) scale(2.6)"><path class="hero-star d0 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(150 410) rotate(6) scale(1.8)"><path class="hero-star d1 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(260 360) rotate(0) scale(1.2)"><path class="hero-star d2 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(350 425) rotate(12) scale(2.2)"><path class="hero-star d3 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(470 350) rotate(0) scale(1.0)"><path class="hero-star d4 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(560 430) rotate(0) scale(1.5)"><path class="hero-star d5 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(650 310) rotate(0) scale(1.0)"><path class="hero-star d6 hero-star-sun text-sun" d={star} fill="currentColor" /></g>
    <g transform="translate(730 400) rotate(-6) scale(2.0)"><path class="hero-star d7 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(840 335) rotate(0) scale(1.3)"><path class="hero-star d0 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(940 430) rotate(-8) scale(2.6)"><path class="hero-star d1 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1030 305) rotate(0) scale(1.1)"><path class="hero-star d2 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1120 395) rotate(8) scale(1.7)"><path class="hero-star d3 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1205 335) rotate(10) scale(3.0)"><path class="hero-star d4 hero-star-sun text-sun" d={star} fill="currentColor" /></g>
    <g transform="translate(1290 425) rotate(0) scale(2.4)"><path class="hero-star d5 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1395 315) rotate(-12) scale(3.4)"><path class="hero-star d6 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1345 215) rotate(0) scale(1.6)"><path class="hero-star d7 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1405 95) rotate(10) scale(2.8)"><path class="hero-star d0 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(90 445) rotate(0) scale(1.1)"><path class="hero-star d1 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(690 455) rotate(0) scale(1.4)"><path class="hero-star d2 text-deep" d={star} fill="currentColor" /></g>
    <g transform="translate(1065 460) rotate(0) scale(1.0)"><path class="hero-star d3 text-deep" d={star} fill="currentColor" /></g>
</svg>
