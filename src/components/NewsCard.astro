---
import type { CollectionEntry } from "astro:content";
import { useTranslations, formatDate, type Locale } from "../i18n/ui";

interface Props {
  post: CollectionEntry<"news">;
  locale: Locale;
  /** Title of the session this post relates to, resolved by the caller. */
  sessionTitle?: string;
}

const { post, locale, sessionTitle } = Astro.props;
const t = useTranslations(locale);
const d = post.data;

/* Posts written in the other language still appear in the list — hiding them
   would make the AZ site look emptier than the organisation actually is —
   but the card says which language it is in. */
const isForeign = d.lang !== locale;
---

<article class="card card-hover p-6">
  <div class="flex flex-wrap items-center gap-2 text-[0.78rem] text-ink-muted">
    <time datetime={d.date.toISOString()}>{formatDate(d.date, locale)}</time>
    {
      isForeign && (
        <span class="badge badge-closed" lang={d.lang}>
          {d.lang.toUpperCase()}
        </span>
      )
    }
    {d.tags.map((tag) => <span class="badge badge-announced">{tag}</span>)}
  </div>

  <h3 class="mt-3 font-display text-[1.15rem] font-bold leading-tight" lang={d.lang}>
    {d.title}
  </h3>

  {
    d.excerpt && (
      <p class="mt-2.5 text-[0.92rem] leading-relaxed text-ink-muted" lang={d.lang}>
        {d.excerpt}
      </p>
    )
  }

  {
    sessionTitle && (
      <p class="mt-4 border-t border-line-soft pt-3 text-[0.8rem] text-ink-muted">
        <span class="font-semibold">{t.news.relatedSession}:</span> {sessionTitle}
      </p>
    )
  }
</article>
