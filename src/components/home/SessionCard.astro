---
import Button from '../Button.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import {
  formatDateRange,
  formatDay,
  isoDay,
  localizeSession,
  type Session,
} from '../../lib/sessions';

interface Props {
  locale: Locale;
  session: Session;
}

const { locale, session } = Astro.props;
const t = useTranslations(locale);
const { startDate, endDate, status, outreach, applyUrl, applyDeadline } = session.data;
const { title, theme, venue } = localizeSession(session, locale);

const isOpen = status === 'call-open';

/* The two kinds are distinguished by more than colour — badge wording, the
   rail, and the outreach note all differ — so the difference survives
   greyscale and colour-blindness. */
const kind = outreach
  ? { label: t('sessions.kind.outreach'), rail: 'bg-sage', badge: 'bg-sage-tint text-ink' }
  : { label: t('sessions.kind.national'), rail: 'bg-azure', badge: 'bg-azure-tint text-ink' };
---

<li
  class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-surface shadow-soft transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-lift"
>
  <span class={`absolute inset-x-0 top-0 h-1 ${kind.rail}`} aria-hidden="true"></span>

  <div class="flex flex-1 flex-col p-6 pt-7 sm:p-7 sm:pt-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class={`rounded-full px-3 py-1 text-xs font-bold tracking-wide uppercase ${kind.badge}`}>
        {kind.label}
      </span>
      <span
        class={`rounded-full px-3 py-1 text-xs font-bold tracking-wide uppercase ${
          isOpen ? 'bg-accent-strong text-white' : 'bg-warm-tint text-ink-muted'
        }`}
      >
        {t(`status.${status}` as 'status.call-open')}
      </span>
    </div>

    <h3 class="font-display mt-5 text-[1.75rem] leading-tight font-semibold text-ink">
      {title}
    </h3>

    <p class="mt-2 leading-relaxed text-ink-muted text-pretty">{theme}</p>

    <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.9375rem] font-medium text-ink">
      <span>{venue}</span>
      <span class="text-ink-muted" aria-hidden="true">·</span>
      <time datetime={isoDay(startDate)}>{formatDateRange(startDate, endDate, locale)}</time>
    </p>

    {
      outreach && (
        <p class="mt-4 rounded-xl bg-sage-tint px-4 py-3 text-[0.9375rem] leading-relaxed text-ink">
          {t('sessions.outreachNote')}
        </p>
      )
    }

    <div class="mt-auto pt-6">
      {
        applyUrl && isOpen ? (
          <>
            <Button href={applyUrl} size="md" class="w-full sm:w-auto">
              {outreach ? t('sessions.cta.form') : t('sessions.cta.members')}
              <span aria-hidden="true">→</span>
            </Button>
            {applyDeadline && (
              <p class="mt-3 text-sm text-ink-muted">
                {t('hero.deadline')}{' '}
                <time datetime={isoDay(applyDeadline)} class="font-semibold text-ink">
                  {formatDay(applyDeadline, locale)}
                </time>
              </p>
            )}
          </>
        ) : (
          <p class="text-sm font-medium text-ink-muted">{t('status.announced')}</p>
        )
      }
    </div>
  </div>
</li>
