---
import Button from '../Button.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import {
  formatDateRange,
  formatDay,
  isoDay,
  localizeSession,
  type Session,
} from '../../lib/sessions';

interface Props {
  locale: Locale;
  session?: Session;
}

const { locale, session } = Astro.props;
const t = useTranslations(locale);

const isOpen = session?.data.status === 'call-open';
const text = session ? localizeSession(session, locale) : null;
---

<section
  class="mx-auto flex min-h-[calc(100dvh-5.5rem)] max-w-6xl flex-col justify-center px-6 pt-10 pb-14 sm:px-8 sm:pb-20"
>
  <div class="max-w-3xl">
    {/* 1 — status chip */}
    <p
      class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/75 py-1.5 pr-4 pl-3 text-[0.8125rem] font-semibold text-ink shadow-soft backdrop-blur-sm"
    >
      {
        isOpen && (
          <span class="relative grid size-2 place-items-center">
            <span class="absolute size-2 rounded-full bg-accent-strong" />
            <span class="ping absolute size-2 rounded-full bg-accent-strong" />
          </span>
        )
      }
      {session ? t(`status.${session.data.status}` as 'status.call-open') : t('hero.fallback.chip')}
    </p>

    {/* 2 — headline, with a hand-drawn stroke instead of an underline */}
    <h1
      class="font-display mt-5 text-[3.25rem] leading-[0.95] font-semibold tracking-[-0.03em] text-balance text-ink sm:text-7xl lg:text-8xl"
    >
      <span class="relative inline-block">
        {text ? text.title : t('hero.fallback.title')}
        <svg
          class="absolute -bottom-1 left-0 h-[0.28em] w-full text-accent"
          viewBox="0 0 300 18"
          preserveAspectRatio="none"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 12.5C52 5.5 108 3.6 160 5.2c40 1.2 89 4.6 137 8.4"
            stroke="currentColor"
            stroke-width="5"
            stroke-linecap="round"
          />
        </svg>
      </span>
    </h1>

    {/* 3 — one-line session name / mission lead */}
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted text-pretty sm:text-xl">
      {text ? text.theme : t('hero.fallback.lead')}
    </p>

    {/* 4 — meta line */}
    {
      session ? (
        <p class="mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.9375rem] font-medium text-ink">
          <span>{text?.venue}</span>
          <span class="text-ink-muted" aria-hidden="true">
            ·
          </span>
          <time datetime={isoDay(session.data.startDate)}>
            {formatDateRange(session.data.startDate, session.data.endDate, locale)}
          </time>
          {session.data.applyDeadline && (
            <>
              <span class="text-ink-muted" aria-hidden="true">
                ·
              </span>
              <time datetime={isoDay(session.data.applyDeadline)}>
                {t('hero.deadline')} {formatDay(session.data.applyDeadline, locale)}
              </time>
            </>
          )}
        </p>
      ) : (
        <p class="mt-4 text-[0.9375rem] font-medium text-ink">{t('hero.fallback.meta')}</p>
      )
    }

    <div class="mt-9 flex flex-wrap items-center gap-3">
      {
        session?.data.applyUrl && isOpen ? (
          <Button href={session.data.applyUrl} size="lg">
            {session.data.outreach ? t('hero.cta.signup') : t('hero.cta.apply')}
          </Button>
        ) : (
          <Button href={`/${locale}/participate`} size="lg">
            {t('nav.join')}
          </Button>
        )
      }
      <Button href={`/${locale}/participate`} variant="secondary" size="lg">
        {t('hero.cta.how')}
      </Button>
    </div>
  </div>
</section>

<style>
  .ping {
    animation: ping 1.9s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%, 100% { transform: scale(2.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ping { animation: none; }
  }
</style>
