---
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Text sits on opaque tinted cards (~11.9:1 with ink) rather than straight on
// the aurora, so the wash can never eat the contrast.
const pillars = [
  { title: t('about.pillar1.title'), body: t('about.pillar1.body'), tint: 'bg-azure-tint', dot: 'bg-azure' },
  { title: t('about.pillar2.title'), body: t('about.pillar2.body'), tint: 'bg-coral-tint', dot: 'bg-coral' },
  { title: t('about.pillar3.title'), body: t('about.pillar3.body'), tint: 'bg-sage-tint', dot: 'bg-sage' },
];
---

<section class="mx-auto max-w-6xl px-6 py-16 sm:px-8 sm:py-24">
  <p class="text-[0.8125rem] font-bold tracking-[0.13em] text-accent-strong uppercase">
    {t('about.eyebrow')}
  </p>

  <h2
    class="font-display mt-4 max-w-2xl text-[2.25rem] leading-[1.05] font-semibold tracking-[-0.025em] text-balance text-ink sm:text-5xl lg:text-[3.5rem]"
  >
    {t('about.title')}
  </h2>

  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted text-pretty">
    {t('about.lead')}
  </p>

  <ul class="mt-12 grid gap-4 sm:grid-cols-3 sm:gap-5">
    {
      pillars.map((pillar, i) => (
        <li
          class={`rounded-card ${pillar.tint} p-6 shadow-soft transition-transform duration-300 ease-out hover:-translate-y-1 sm:p-7`}
        >
          <div class="flex items-center gap-2.5">
            <span class={`size-2.5 rounded-full ${pillar.dot}`} aria-hidden="true" />
            <span class="font-display text-sm font-semibold text-ink-muted tabular-nums">
              0{i + 1}
            </span>
          </div>
          <h3 class="font-display mt-4 text-[1.375rem] leading-snug font-semibold text-ink">
            {pillar.title}
          </h3>
          <p class="mt-2.5 leading-relaxed text-ink-muted text-pretty">{pillar.body}</p>
        </li>
      ))
    }
  </ul>
</section>
