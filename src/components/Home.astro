---
import { getCollection } from 'astro:content';
import Hero from './home/Hero.astro';
import WhatIsEyp from './home/WhatIsEyp.astro';
import UpcomingSessions from './home/UpcomingSessions.astro';
import { heroSession, upcomingSessions } from '../lib/sessions';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/* Static output means `now` is frozen at build time: a call that closes
   tomorrow keeps showing until the site is rebuilt. Scheduled rebuilds are an
   open item in PLAN.md. */
const now = new Date();
const all = await getCollection('sessions');
const upcoming = upcomingSessions(all, now);
const hero = heroSession(all, now);
---

<Hero locale={locale} session={hero} />
<WhatIsEyp locale={locale} />
<UpcomingSessions locale={locale} sessions={upcoming} />
