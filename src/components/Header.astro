---
import { useTranslations, primaryNav, localePath, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const other: Locale = locale === "az" ? "en" : "az";
const restOfPath = Astro.url.pathname.replace(/^\/(en|az)/, "");
const switcherHref = `/${other}${restOfPath}`;

/* Mark the active item. Compare on the un-prefixed path so both locales work. */
const current = restOfPath.replace(/^\/|\/$/g, "");
const isActive = (path: string) =>
  path === "" ? current === "" : current === path || current.startsWith(`${path}/`);

/* Header nav: Home plus the primary items. The reference nav renders as a
   pale-blue pill group with the active page as a solid blue pill. */
const headerNav: { label: string; path: string }[] = [
  { label: t.nav.home, path: "" },
  ...primaryNav.map((item) => ({ label: t.nav[item.key], path: item.path })),
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md">
  <div class="wrap flex min-h-[96px] items-center gap-4">
    <!-- Two-line typographic wordmark -->
    <a href={localePath(locale)} class="shrink-0 leading-tight" aria-label={t.site.name}>
      <span class="block font-display text-[0.95rem] tracking-[0.02em] text-ink">
        EUROPEAN <b class="font-extrabold">YOUTH</b> PARLIAMENT
      </span>
      <span class="block text-right font-display text-[0.95rem] tracking-[0.02em] text-ink">
        <b class="font-extrabold">AZ&#399;RBAYCAN</b> AZERBAIJAN
      </span>
    </a>

    <!-- Desktop nav: pill group -->
    <nav
      class="ms-auto hidden items-center gap-1 rounded-full bg-deep-050 p-1.5 lg:flex"
      aria-label="Primary"
    >
      {
        headerNav.map((item) => (
          <a
            href={localePath(locale, item.path)}
            aria-current={isActive(item.path) ? "page" : undefined}
            class:list={[
              "whitespace-nowrap rounded-full px-4 py-2.5 font-display text-[0.95rem] font-semibold transition-colors xl:px-5 xl:py-3 xl:text-[1.05rem]",
              isActive(item.path)
                ? "bg-deep text-white"
                : "text-ink hover:bg-white hover:text-deep",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={switcherHref}
        hreflang={other}
        lang={other}
        class="ms-1 whitespace-nowrap rounded-full bg-deep px-4 py-2.5 font-display text-[0.95rem] font-semibold text-white transition-colors hover:bg-deep-700 xl:px-5 xl:py-3 xl:text-[1.05rem]"
      >
        {t.nav.switchLang}
      </a>
    </nav>

    <!-- Mobile: language pill + burger -->
    <div class="ms-auto flex items-center gap-2 lg:hidden">
      <a
        href={switcherHref}
        hreflang={other}
        lang={other}
        class="rounded-full bg-deep px-3.5 py-2 font-display text-[0.74rem] font-bold uppercase text-white"
      >
        {other}
      </a>

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.menu}
        class="grid h-10 w-10 place-items-center rounded-full bg-deep-050 text-deep transition-colors hover:bg-deep hover:text-white"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path class="nav-icon-open" d="M3 6h18M3 12h18M3 18h18" />
          <path class="nav-icon-close hidden" d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-nav"
    hidden
    class="border-t border-line bg-white lg:hidden"
    aria-label="Primary"
  >
    <div class="wrap flex flex-col py-2">
      {
        headerNav.map((item) => (
          <a
            href={localePath(locale, item.path)}
            aria-current={isActive(item.path) ? "page" : undefined}
            class:list={[
              "border-b border-line-soft py-3.5 font-display text-[1rem] font-semibold",
              isActive(item.path) ? "text-deep" : "text-ink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={localePath(locale, "partners")} class="border-b border-line-soft py-3.5 font-display text-[1rem] font-semibold text-ink">
        {t.nav.partners}
      </a>
      <a href={localePath(locale, "participate")} class="btn btn-primary my-4">
        {t.nav.participate}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");
  const iconOpen = document.querySelector<SVGPathElement>(".nav-icon-open");
  const iconClose = document.querySelector<SVGPathElement>(".nav-icon-close");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  /* A resize past the lg breakpoint must clear `hidden`, or the desktop nav
     stays invisible after the mobile panel was closed. */
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
