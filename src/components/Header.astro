---
import { navItems, useTranslations, type Locale } from '../i18n/ui';
import Button from './Button.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const otherLocale: Locale = locale === 'az' ? 'en' : 'az';
const restOfPath = Astro.url.pathname.replace(/^\/(en|az)/, '');
const switcherHref = `/${otherLocale}${restOfPath}`;
---

<header class="sticky top-0 z-50">
  <div class="mx-auto max-w-6xl px-3 pt-3 sm:px-5 sm:pt-4">
    <div
      class="flex items-center justify-between gap-3 rounded-full border border-line/80 bg-surface/80 py-2 pr-2 pl-4 shadow-soft backdrop-blur-md sm:pr-2.5 sm:pl-6"
    >
      <a href={`/${locale}/`} class="group -my-1 block shrink py-1">
        <span
          class="font-display block text-[1.0625rem] leading-tight font-semibold text-ink sm:text-xl"
        >
          {t('site.name')}
        </span>
        <span
          class="block text-[0.625rem] leading-tight font-medium tracking-[0.09em] text-ink-muted uppercase sm:text-[0.6875rem]"
        >
          {t('site.tagline')}
        </span>
      </a>

      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        <Button href={`/${locale}/participate`} size="sm">
          {t('nav.join')}
        </Button>

        <a
          href={switcherHref}
          hreflang={otherLocale}
          aria-label={t('nav.language')}
          class="grid size-10 place-items-center rounded-full border border-line text-ink-muted transition-colors hover:border-ink/25 hover:text-ink"
        >
          <svg viewBox="0 0 24 24" class="size-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
          </svg>
          <span class="sr-only">{otherLocale.toUpperCase()}</span>
        </a>

        <button
          type="button"
          id="menu-toggle"
          aria-controls="site-menu"
          aria-expanded="false"
          aria-label={t('nav.openMenu')}
          data-label-open={t('nav.openMenu')}
          data-label-close={t('nav.closeMenu')}
          class="grid size-10 place-items-center rounded-full border border-line text-ink transition-colors hover:border-ink/25"
        >
          <span class="burger" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Full-screen menu. `hidden` by default; the no-JS path below re-exposes the
     same links so the site stays navigable without scripts. -->
<div
  id="site-menu"
  hidden
  class="fixed inset-0 z-40 overflow-y-auto bg-ground/97 pt-24 pb-12 backdrop-blur-xl"
>
  <nav aria-label={t('nav.menu')} class="mx-auto max-w-6xl px-6">
    <ul class="grid gap-1 sm:grid-cols-2 sm:gap-x-10">
      {
        navItems.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a
              href={`/${locale}/${item.path}`}
              class="font-display block border-b border-line/70 py-4 text-[1.75rem] leading-tight font-semibold text-ink transition-colors hover:text-accent-strong sm:text-[2rem]"
            >
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <Button href={`/${locale}/participate`} size="lg">{t('nav.join')}</Button>
      <Button href={switcherHref} variant="secondary" size="lg">
        {otherLocale === 'az' ? 'Azərbaycanca' : 'English'}
      </Button>
    </div>
  </nav>
</div>

<noscript>
  <nav aria-label={t('nav.menu')} class="mx-auto max-w-6xl px-5 pt-3">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-ink-muted">
      {
        navItems.map((item) => (
          <li>
            <a href={`/${locale}/${item.path}`} class="underline underline-offset-4 hover:text-ink">
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</noscript>

<style>
  /* Burger drawn from one element so there is no markup noise; becomes an X
     when the panel is open. */
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1.0625rem;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.24s ease,
      opacity 0.16s ease;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: relative;
  }
  .burger::before { top: -5.5px; }
  .burger::after { top: 4px; }

  :global([aria-expanded='true']) .burger { background: transparent; }
  :global([aria-expanded='true']) .burger::before { transform: translateY(5.5px) rotate(45deg); }
  :global([aria-expanded='true']) .burger::after { transform: translateY(-4px) rotate(-45deg); }

  /* Plays on reveal because the element goes from display:none to block. */
  .menu-item {
    animation: menu-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--i) * 45ms + 40ms);
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-item { animation: none; }
  }
</style>

<script is:inline src="/menu.js" defer></script>
