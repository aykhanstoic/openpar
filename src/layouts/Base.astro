---
/* Self-hosted, full package CSS: latin-ext carries the Azerbaijani ə, ğ, ş. */
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations, locales, stripLocale, localePath, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Set on the home page so the <title> is not "Home | EYP Azerbaijan". */
  bareTitle?: boolean;
  /**
   * Set when this page exists in `locale` only (a one-language session). The
   * language switch then goes to this path in the other locale (given without
   * the locale prefix, e.g. "sessions"), and no hreflang pairs are emitted.
   */
  singleLocaleFallback?: string;
}

const { locale, title, description, bareTitle = false, singleLocaleFallback } = Astro.props;
const t = useTranslations(locale);

const pageTitle = bareTitle ? `${t.site.name} — ${t.site.tagline}` : `${title} | ${t.site.name}`;
const pageDescription = description ?? t.site.description;

/* Path without the locale prefix, used for hreflang and the switcher. */
const restOfPath = stripLocale(Astro.url.pathname) || "/";
const other: Locale = locales.find((l) => l !== locale) ?? locale;
const switcherHref =
  singleLocaleFallback === undefined ? `/${other}${restOfPath}` : localePath(other, singleLocaleFallback);
const site = Astro.site ?? "https://eyp.az";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://eyp.az");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    {/* Tell search engines the two locales are the same page, not duplicates. */}
    {singleLocaleFallback === undefined && (
      <>
        {locales.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(`/${l}${restOfPath}`, site).href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(`/en${restOfPath}`, site).href} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === "az" ? "az_AZ" : "en_GB"} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50 focus:bg-deep focus:px-5 focus:py-3 focus:text-white"
    >
      {t.nav.skipToContent}
    </a>

    <Header locale={locale} other={other} switcherHref={switcherHref} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
