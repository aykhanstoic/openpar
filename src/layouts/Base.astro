---
import '../styles/global.css';
import { navItems, useTranslations, type Locale, type UIKey } from '../i18n/ui';

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const otherLocale: Locale = locale === 'az' ? 'en' : 'az';
const restOfPath = Astro.url.pathname.replace(/^\/(en|az)/, '');
const switcherHref = `/${otherLocale}${restOfPath}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | {t('site.name')}</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <header class="border-b border-gray-200">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href={`/${locale}/`} class="text-lg font-semibold text-accent">
          {t('site.name')}
        </a>
        <nav class="flex flex-wrap items-center gap-4 text-sm">
          {navItems.map((item) => (
            <a
              href={`/${locale}/${item.path}`}
              class="hover:text-accent"
            >
              {t(item.key as UIKey)}
            </a>
          ))}
          <a href={switcherHref} class="border border-gray-300 px-2 py-1 hover:border-accent hover:text-accent">
            {otherLocale.toUpperCase()}
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200">
      <div class="mx-auto max-w-4xl px-4 py-6 text-sm text-gray-500">
        <p>{t('footer.copyright')}</p>
        <p>{t('footer.partners')}</p>
      </div>
    </footer>
  </body>
</html>
