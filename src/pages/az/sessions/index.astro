---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('az');
const sessions = await getCollection('sessions');
sessions.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('az', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Sessiyalar">
  <h1 class="text-3xl font-semibold">Sessiyalar</h1>
  <p class="mt-4 text-gray-600">EYP Azerbaijan-ın keçmiş və gələcək sessiyaları.</p>

  <ul class="mt-8 space-y-6">
    {sessions.map((session) => (
      <li class="border border-gray-200 p-4">
        <h2 class="text-xl font-medium">{session.data.title}</h2>
        <p class="text-gray-600">{session.data.theme}</p>
        <p class="mt-1 text-sm text-gray-500">
          {session.data.venue} — {dateFormat.format(session.data.startDate)} - {dateFormat.format(session.data.endDate)}
        </p>
        <p class="mt-1 text-sm text-gray-500">Status: {session.data.status}</p>
        {session.data.applyUrl && (
          <a
            href={session.data.applyUrl}
            class="mt-3 inline-block border border-accent px-3 py-1 text-sm text-accent hover:bg-accent hover:text-white"
          >
            {session.data.outreach ? t('apply.googleForm') : t('apply.membersPlatform')}
          </a>
        )}
      </li>
    ))}
  </ul>
</Base>
