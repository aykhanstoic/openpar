---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const board = await getCollection('board');
const executive = board.filter((m) => m.data.body === 'executive').sort((a, b) => a.data.order - b.data.order);
const supervisory = board.filter((m) => m.data.body === 'supervisory').sort((a, b) => a.data.order - b.data.order);
---

<Base title="Haqqımızda">
  <h1 class="text-3xl font-semibold">Haqqımızda</h1>
  <p class="mt-4 text-gray-600">
    Placeholder giriş paraqrafı — EYP Azerbaijan milli komitəsi haqqında.
  </p>

  <h2 class="mt-8 text-xl font-medium">İcraiyyə Şurası</h2>
  <ul class="mt-2 space-y-1">
    {executive.map((member) => (
      <li>{member.data.name} — {member.data.role}</li>
    ))}
  </ul>

  <h2 class="mt-8 text-xl font-medium">Nəzarət Şurası</h2>
  <ul class="mt-2 space-y-1">
    {supervisory.map((member) => (
      <li>{member.data.name} — {member.data.role}</li>
    ))}
  </ul>
</Base>
