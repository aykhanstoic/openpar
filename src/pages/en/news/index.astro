---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const news = await getCollection('news');
news.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="News">
  <h1 class="text-3xl font-semibold">News</h1>

  <ul class="mt-8 space-y-6">
    {news.map((post) => (
      <li class="border border-gray-200 p-4">
        <span class="text-xs uppercase text-gray-500">{post.data.lang}</span>
        <h2 class="text-xl font-medium">{post.data.title}</h2>
        <p class="text-sm text-gray-500">{dateFormat.format(post.data.date)}</p>
        {post.data.excerpt && <p class="mt-1 text-gray-600">{post.data.excerpt}</p>}
      </li>
    ))}
  </ul>
</Base>
