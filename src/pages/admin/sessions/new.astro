---
export const prerender = false;

import Admin from "../../../layouts/Admin.astro";
import SessionForm from "../../../components/admin/SessionForm.astro";
import { isLoggedIn, sameOrigin } from "../../../lib/admin/auth";
import { getStore, ConflictError } from "../../../lib/admin/store";
import { readForm, validateSession, slugFor, toSessionFile, type SessionFormValues } from "../../../lib/admin/session-doc";

const { request, url, cookies } = Astro;
if (!isLoggedIn(cookies)) return Astro.redirect("/admin/", 303);
const store = getStore();
if (!store) return Astro.redirect("/admin/", 303);

let values: SessionFormValues = {
  title: "", theme: "", summary: "", venue: "", city: "", startDate: "", endDate: "",
  status: "announced", applyDeadline: "", type: "", outreach: "", applyUrl: "",
  resolutionsUrl: "", lang: "both", draft: "", body: "", editor: "",
};
let errors: Record<string, string> = {};

if (request.method === "POST") {
  if (!sameOrigin(request, url)) return new Response("Forbidden", { status: 403 });
  const read = readForm(await request.formData());
  values = read.values;
  const parsed = validateSession(read.input, values);

  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    const form = parsed.data;
    try {
      /* Same title and year as an existing session: add -2, -3, ... */
      const base = slugFor(form.title, form.startDate);
      const taken = new Set((await store.list()).map((f) => f.id));
      let id = base;
      for (let n = 2; taken.has(id); n++) id = `${base}-${n}`;

      await store.create(id, toSessionFile(form), `Add session "${form.title}" (via /admin, by ${form.editor})`);
      return Astro.redirect("/admin/?done=created", 303);
    } catch (e) {
      console.error(e);
      errors = {
        form: e instanceof ConflictError ? e.message : "Saving failed. Nothing was published. Try again in a minute.",
      };
    }
  }
  Astro.response.status = 400;
}
---

<Admin title="New session" loggedIn>
  <p><a href="/admin/" class="text-deep underline">← All sessions</a></p>
  <h1 class="mt-3 mb-6 font-display text-3xl font-bold text-deep">New session</h1>
  <SessionForm values={values} errors={errors} submitLabel="Save and publish" />
</Admin>
