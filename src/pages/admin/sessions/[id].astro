---
export const prerender = false;

import Admin from "../../../layouts/Admin.astro";
import SessionForm from "../../../components/admin/SessionForm.astro";
import { isLoggedIn, sameOrigin } from "../../../lib/admin/auth";
import { getStore, ConflictError } from "../../../lib/admin/store";
import {
  ID_PATTERN,
  readForm,
  validateSession,
  formValuesFrom,
  parseSessionFile,
  toSessionFile,
  type SessionFormValues,
} from "../../../lib/admin/session-doc";

const { request, url, cookies, params } = Astro;
if (!isLoggedIn(cookies)) return Astro.redirect("/admin/", 303);
const store = getStore();
if (!store) return Astro.redirect("/admin/", 303);

const id = params.id ?? "";
if (!ID_PATTERN.test(id)) return new Response("Not found", { status: 404 });

const file = await store.get(id);
if (!file) return new Response("Not found", { status: 404 });
const current = parseSessionFile(file.content);

let values: SessionFormValues = formValuesFrom(current);
let errors: Record<string, string> = {};
let deleteError = "";

if (request.method === "POST") {
  if (!sameOrigin(request, url)) return new Response("Forbidden", { status: 403 });
  const data = await request.formData();
  /* The version the editor opened, not the one just fetched: a save over
     someone else's newer edit must be refused, not silently win. */
  const sha = String(data.get("sha") ?? "") || undefined;

  if (data.get("action") === "delete") {
    const editor = String(data.get("editor") ?? "").trim().slice(0, 60);
    if (!data.get("confirm") || !editor) {
      deleteError = "Tick the box and write your name to delete.";
    } else {
      try {
        await store.remove(id, `Delete session "${values.title}" (via /admin, by ${editor})`, sha);
        return Astro.redirect("/admin/?done=deleted", 303);
      } catch (e) {
        console.error(e);
        deleteError = e instanceof ConflictError ? e.message : "Deleting failed. Try again in a minute.";
      }
    }
  } else {
    const read = readForm(data);
    values = read.values;
    const parsed = validateSession(read.input, values);
    if (!parsed.ok) {
      errors = parsed.errors;
    } else {
      try {
        await store.update(
          id,
          toSessionFile(parsed.data, current),
          `Update session "${parsed.data.title}" (via /admin, by ${parsed.data.editor})`,
          sha,
        );
        return Astro.redirect("/admin/?done=updated", 303);
      } catch (e) {
        console.error(e);
        errors = {
          form: e instanceof ConflictError ? e.message : "Saving failed. Nothing was published. Try again in a minute.",
        };
      }
    }
  }
  Astro.response.status = 400;
}
---

<Admin title={`Edit: ${values.title || id}`} loggedIn>
  <p><a href="/admin/" class="text-deep underline">← All sessions</a></p>
  <h1 class="mt-3 font-display text-3xl font-bold text-deep">Edit session</h1>
  <p class="mt-1 mb-6 text-sm text-ink-muted">
    Web address: <a class="underline" href={`/en/sessions/${id}/`}>/en/sessions/{id}/</a>
  </p>

  <SessionForm values={values} errors={errors} submitLabel="Save changes" sha={file.sha} />

  <form method="post" class="mt-12 grid gap-4 rounded border border-[#B42318] bg-white p-5">
    <h2 class="font-display text-xl font-bold text-[#B42318]">Delete this session</h2>
    <p class="text-sm text-ink-muted">It disappears from the website. The board can still recover it from the change history.</p>
    <input type="hidden" name="action" value="delete" />
    {file.sha && <input type="hidden" name="sha" value={file.sha} />}
    <div>
      <label for="delete-editor" class="block font-semibold">Your name</label>
      <input id="delete-editor" name="editor" required maxlength="60" autocomplete="name" class="mt-1 block w-full max-w-sm rounded border border-line px-3 py-2" />
    </div>
    <label class="flex items-center gap-3">
      <input type="checkbox" name="confirm" required class="h-5 w-5" />
      <span>Yes, delete "{values.title || id}"</span>
    </label>
    {deleteError && <p role="alert" class="text-sm font-semibold text-[#B42318]">{deleteError}</p>}
    <button type="submit" class="justify-self-start rounded bg-[#B42318] px-5 py-2.5 font-semibold text-white hover:bg-[#912018]">Delete session</button>
  </form>
</Admin>
