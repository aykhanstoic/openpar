---
export const prerender = false;

import Admin from "../../../layouts/Admin.astro";
import EntryForm from "../../../components/admin/EntryForm.astro";
import { isLoggedIn, rememberEditor, rememberedEditor, sameOrigin } from "../../../lib/admin/auth";
import { getCollection, parseEntry, readValues, toFile, validate, valuesFrom, type Values } from "../../../lib/admin/collections";
import { ID_PATTERN } from "../../../lib/admin/frontmatter";
import { referenceChoices } from "../../../lib/admin/references";
import { getStore, pathOf } from "../../../lib/admin/store";
import { keptPhotos, photoChanges, photoDeletes, readPhotos } from "../../../lib/admin/entry-photos";

const { request, url, cookies, params } = Astro;
if (!isLoggedIn(cookies)) return Astro.redirect("/admin/", 303);
const c = getCollection(params.collection);
if (!c) return new Response("Not found", { status: 404 });
const store = getStore(c.folder);
if (!store) return Astro.redirect(`/admin/${c.id}/`, 303);

const id = params.id ?? "";
if (!ID_PATTERN.test(id)) return new Response("Not found", { status: 404 });
const file = await store.get(id);
if (!file) return new Response("Not found", { status: 404 });
const current = parseEntry(file.content);
const name = String(current.data.title ?? current.data.name ?? id);

const refs = await referenceChoices(c);
let values: Values = { ...valuesFrom(c, current), editor: rememberedEditor(cookies) };
let errors: Record<string, string> = {};
let deleteError = "";
let kept: Record<string, string> = {};

if (request.method === "POST") {
  if (!sameOrigin(request, url)) return new Response("Forbidden", { status: 403 });
  const form = await request.formData();
  /* The version the editor opened, not the one just fetched: a save over
     someone else's newer edit must be refused, not silently win. */
  const sha = String(form.get("sha") ?? "") || undefined;

  if (form.get("action") === "delete") {
    const editor = String(form.get("editor") ?? "").trim().slice(0, 60);
    if (!form.get("confirm") || !editor) {
      deleteError = "Tick the box and write your name to delete.";
    } else {
      try {
        const message = `Delete ${c.singular} "${name}" (via /admin, by ${editor})`;
        const photos = photoDeletes(c, current.data);
        if (photos.length) {
          const path = pathOf(c.folder, id);
          await store.commit([{ path, content: null }, ...photos], message, { path, sha });
        } else {
          await store.remove(id, message, sha);
        }
        return Astro.redirect(`/admin/${c.id}/?done=deleted`, 303);
      } catch (e) {
        console.error(e);
        deleteError = e instanceof Error ? e.message : "Deleting failed.";
      }
    }
  } else {
    values = readValues(c, form);
    const photos = await readPhotos(c, form);
    kept = keptPhotos(photos.choices);
    const result = validate(c, values, refs.ids);
    if (!result.ok || Object.keys(photos.errors).length) {
      errors = { ...(result.ok ? {} : result.errors), ...photos.errors };
    } else {
      try {
        const title = values.title || values.name;
        const message = `Update ${c.singular} "${title}" (via /admin, by ${values.editor})`;
        const changes = photoChanges(c, photos.choices, result.data, id);
        if (changes.length) {
          const path = pathOf(c.folder, id);
          await store.commit([...changes, { path, content: toFile(c, result, current) }], message, { path, sha });
        } else {
          await store.update(id, toFile(c, result, current), message, sha);
        }
        rememberEditor(cookies, values.editor, url.protocol === "https:");
        return Astro.redirect(`/admin/${c.id}/?done=updated`, 303);
      } catch (e) {
        console.error(e);
        errors = { form: e instanceof Error ? e.message : "Saving failed. Nothing was published." };
      }
    }
  }
  Astro.response.status = 400;
}
---

<Admin title={`Edit: ${name}`} loggedIn>
  <p><a href={`/admin/${c.id}/`} class="text-deep underline">← {c.label}</a></p>
  <h1 class="mt-3 font-display text-3xl font-bold text-deep">{name}</h1>
  {
    c.publicPath && (
      <p class="mt-1 text-sm text-ink-muted">
        On the website: <a class="underline" href={`/en/${c.publicPath(id)}`}>English</a> ·{" "}
        <a class="underline" href={`/az/${c.publicPath(id)}`}>Azerbaijani</a>
      </p>
    )
  }
  <div class="mt-6">
    <EntryForm collection={c} values={values} errors={errors} submitLabel="Save changes" sha={file.sha} refOptions={refs.options} kept={kept} />
  </div>

  <form method="post" class="mt-12 grid gap-4 rounded border border-[#B42318] bg-white p-5">
    <h2 class="font-display text-xl font-bold text-[#B42318]">Delete this {c.singular}</h2>
    <p class="text-sm text-ink-muted">It disappears from the website. The board can still recover it from the change history.</p>
    <input type="hidden" name="action" value="delete" />
    {file.sha && <input type="hidden" name="sha" value={file.sha} />}
    <div>
      <label for="delete-editor" class="block font-semibold">Your name</label>
      <input id="delete-editor" name="editor" value={rememberedEditor(cookies)} maxlength="60" autocomplete="name" class="mt-1 block w-full max-w-sm rounded border border-line px-3 py-2" />
    </div>
    <label class="flex items-center gap-3">
      <input type="checkbox" name="confirm" class="h-5 w-5" />
      <span>Yes, delete "{name}"</span>
    </label>
    {deleteError && <p role="alert" class="text-sm font-semibold text-[#B42318]">{deleteError}</p>}
    <button type="submit" class="justify-self-start rounded bg-[#B42318] px-5 py-2.5 font-semibold text-white hover:bg-[#912018]">Delete</button>
  </form>
</Admin>
