---
/**
 * /admin: the password screen, and once logged in the dashboard that leads
 * to every editable part of the site. Rendered on request (a Vercel
 * Function), unlike the rest of the site.
 */
export const prerender = false;

import Admin from "../../layouts/Admin.astro";
import { authConfig, isLoggedIn, logIn, logOut, sameOrigin, MIN_PASSWORD_LENGTH } from "../../lib/admin/auth";
import { COLLECTIONS } from "../../lib/admin/collections";
import { PAGES } from "../../lib/admin/pages";

const { request, url, cookies } = Astro;
let loginError = "";

if (request.method === "POST") {
  if (!sameOrigin(request, url)) return new Response("Forbidden", { status: 403 });
  const form = await request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "logout") {
    logOut(cookies);
    return Astro.redirect("/admin/", 303);
  }

  if (action === "login") {
    const result = await logIn(cookies, String(form.get("password") ?? ""), Astro.clientAddress, url.protocol === "https:");
    if (result === "ok") return Astro.redirect("/admin/", 303);
    loginError = {
      wrong: "That password is not right.",
      blocked: "Too many wrong passwords. Wait 15 minutes and try again.",
      unconfigured: "The editor is not set up yet.",
    }[result];
    Astro.response.status = result === "blocked" ? 429 : 401;
  }
}

const config = authConfig();
const loggedIn = isLoggedIn(cookies);

const areas = [
  {
    href: "/admin/pages/",
    title: "Page text",
    body: `The wording on the ${PAGES.length} pages of the site (About us, What is EYP?, Get involved, Contact...), in English and Azerbaijani.`,
  },
  {
    href: "/admin/photos",
    title: "Page photos",
    body: "The photos on the Home, About us and Get involved pages.",
  },
  ...Object.values(COLLECTIONS).map((c) => ({ href: `/admin/${c.id}/`, title: c.label, body: c.description })),
];
---

<Admin title={loggedIn ? "Dashboard" : "Log in"} loggedIn={loggedIn}>
  {
    !loggedIn && (
      <section class="mx-auto max-w-sm rounded border border-line bg-white p-6">
        <h1 class="font-display text-2xl font-bold text-deep">Log in</h1>
        {!config.ok ? (
          <div role="alert" class="mt-4 text-ink">
            <p class="font-semibold">The editor is not set up yet.</p>
            <p class="mt-2 text-sm text-ink-muted">
              Whoever manages the website needs to set <code>ADMIN_PASSWORD</code> (at least {MIN_PASSWORD_LENGTH} characters)
              and <code>ADMIN_SESSION_SECRET</code> in Vercel. See the README.
            </p>
          </div>
        ) : (
          <form method="post" class="mt-4 grid gap-4">
            <input type="hidden" name="action" value="login" />
            <div>
              <label for="password" class="block font-semibold">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                autofocus
                class="mt-1 block w-full rounded border border-line px-3 py-2 focus:border-deep focus:outline-none focus:ring-2 focus:ring-deep-050"
                aria-describedby={loginError ? "login-error" : undefined}
                aria-invalid={loginError ? "true" : undefined}
              />
            </div>
            {loginError && (
              <p id="login-error" role="alert" class="text-sm font-semibold text-[#B42318]">
                {loginError}
              </p>
            )}
            <button type="submit" class="btn btn-primary justify-self-start">Log in</button>
          </form>
        )}
      </section>
    )
  }

  {
    loggedIn && (
      <section>
        <h1 class="font-display text-3xl font-bold text-deep">What do you want to change?</h1>
        <p class="mt-2 text-ink-muted">
          Everything you save here goes live on the website about two minutes later. Every change is kept in the history
          with your name, so nothing is ever lost for good.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {areas.map((a) => (
            <li>
              <a href={a.href} class="block h-full rounded border border-line bg-white p-5 hover:border-deep hover:bg-deep-050">
                <span class="font-display text-xl font-bold text-deep underline">{a.title}</span>
                <span class="mt-1 block text-ink-muted">{a.body}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-ink-muted">
          Not editable here: the menu, buttons and footer labels. Ask whoever manages the website for those.
        </p>
      </section>
    )
  }
</Admin>
