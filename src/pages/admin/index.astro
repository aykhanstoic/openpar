---
/**
 * /admin: the password screen, and once logged in the list of sessions.
 * Rendered on request (a Vercel Function), unlike the rest of the site.
 */
export const prerender = false;

import Admin from "../../layouts/Admin.astro";
import { authConfig, isLoggedIn, logIn, logOut, sameOrigin, MIN_PASSWORD_LENGTH } from "../../lib/admin/auth";
import { getStore, type StoredFile } from "../../lib/admin/store";
import { parseSessionFile } from "../../lib/admin/session-doc";
import { STATUS_LABELS } from "../../lib/session-fields";

const { request, url, cookies } = Astro;
let loginError = "";

if (request.method === "POST") {
  if (!sameOrigin(request, url)) return new Response("Forbidden", { status: 403 });
  const form = await request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "logout") {
    logOut(cookies);
    return Astro.redirect("/admin/", 303);
  }

  if (action === "login") {
    const result = await logIn(cookies, String(form.get("password") ?? ""), Astro.clientAddress, url.protocol === "https:");
    if (result === "ok") return Astro.redirect("/admin/", 303);
    loginError = {
      wrong: "That password is not right.",
      blocked: "Too many wrong passwords. Wait 15 minutes and try again.",
      unconfigured: "The editor is not set up yet.",
    }[result];
    Astro.response.status = result === "blocked" ? 429 : 401;
  }
}

const config = authConfig();
const loggedIn = isLoggedIn(cookies);
const store = loggedIn ? getStore() : null;

/* Fixed messages keyed by a query flag; nothing from the URL is echoed. */
const notices: Record<string, string> = {
  created: "Session saved.",
  updated: "Changes saved.",
  deleted: "Session deleted.",
};
const done = notices[url.searchParams.get("done") ?? ""];
const publishNote =
  store?.kind === "local"
    ? "Local mode: only the files on this computer changed. Nothing was sent to GitHub."
    : "The website updates in about two minutes.";

interface Row {
  id: string;
  title: string;
  startDate: string;
  status: string;
  draft: boolean;
}
let rows: Row[] = [];
let loadError = "";
if (store) {
  try {
    const files: StoredFile[] = await store.list();
    rows = files
      .map((f) => {
        const d = parseSessionFile(f.content).data;
        const start = d.startDate instanceof Date ? d.startDate.toISOString().slice(0, 10) : String(d.startDate ?? "");
        return {
          id: f.id,
          title: String(d.title ?? f.id),
          startDate: start,
          status: STATUS_LABELS[d.status as keyof typeof STATUS_LABELS] ?? String(d.status ?? ""),
          draft: Boolean(d.draft),
        };
      })
      .sort((a, b) => b.startDate.localeCompare(a.startDate));
  } catch (e) {
    console.error(e);
    loadError = "Could not load the sessions. Try again in a minute; if it keeps happening, tell whoever manages the website.";
  }
}
---

<Admin title={loggedIn ? "Sessions" : "Log in"} loggedIn={loggedIn}>
  {
    !loggedIn && (
      <section class="mx-auto max-w-sm rounded border border-line bg-white p-6">
        <h1 class="font-display text-2xl font-bold text-deep">Log in</h1>
        {!config.ok ? (
          <div role="alert" class="mt-4 text-ink">
            <p class="font-semibold">The editor is not set up yet.</p>
            <p class="mt-2 text-sm text-ink-muted">
              Whoever manages the website needs to set <code>ADMIN_PASSWORD</code> (at least {MIN_PASSWORD_LENGTH} characters)
              and <code>ADMIN_SESSION_SECRET</code> in Vercel. See the README.
            </p>
          </div>
        ) : (
          <form method="post" class="mt-4 grid gap-4">
            <input type="hidden" name="action" value="login" />
            <div>
              <label for="password" class="block font-semibold">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                autofocus
                class="mt-1 block w-full rounded border border-line px-3 py-2 focus:border-deep focus:outline-none focus:ring-2 focus:ring-deep-050"
                aria-describedby={loginError ? "login-error" : undefined}
                aria-invalid={loginError ? "true" : undefined}
              />
            </div>
            {loginError && (
              <p id="login-error" role="alert" class="text-sm font-semibold text-[#B42318]">
                {loginError}
              </p>
            )}
            <button type="submit" class="btn btn-primary justify-self-start">Log in</button>
          </form>
        )}
      </section>
    )
  }

  {
    loggedIn && (
      <section>
        <div class="flex flex-wrap items-center gap-4">
          <h1 class="font-display text-3xl font-bold text-deep">Sessions</h1>
          {store && (
            <a href="/admin/sessions/new" class="btn btn-primary ms-auto">
              New session
            </a>
          )}
        </div>

        {done && (
          <p role="status" class="mt-6 rounded border border-deep bg-deep-050 p-3">
            <strong>{done}</strong> {publishNote}
          </p>
        )}

        {!store && (
          <p role="alert" class="mt-6 rounded border border-[#B42318] bg-white p-3">
            Saving is not set up yet: <code>GITHUB_TOKEN</code> is missing in Vercel. See the README.
          </p>
        )}
        {loadError && (
          <p role="alert" class="mt-6 rounded border border-[#B42318] bg-white p-3">
            {loadError}
          </p>
        )}

        {store && !loadError && (
          rows.length === 0 ? (
            <p class="mt-6 text-ink-muted">No sessions yet.</p>
          ) : (
            <ul class="mt-6 divide-y divide-line rounded border border-line bg-white">
              {rows.map((r) => (
                <li>
                  <a href={`/admin/sessions/${r.id}`} class="flex flex-wrap items-baseline gap-x-4 gap-y-1 p-4 hover:bg-deep-050">
                    <span class="font-semibold text-deep underline">{r.title}</span>
                    <span class="text-sm text-ink-muted">{r.startDate}</span>
                    <span class="text-sm text-ink-muted">{r.status}</span>
                    {r.draft && <span class="badge badge-closed">Draft</span>}
                  </a>
                </li>
              ))}
            </ul>
          )
        )}
      </section>
    )
  }
</Admin>
