---
/** Shown in place of an admin page whose content could not be loaded (see lib/admin/unavailable.ts). */
export const prerender = false;

import Admin from "../../layouts/Admin.astro";
import { isLoggedIn } from "../../lib/admin/auth";

if (!isLoggedIn(Astro.cookies)) return Astro.redirect("/admin/", 303);
Astro.response.status = 502;
const message = Astro.locals.loadError ?? "Something went wrong loading this page.";
---

<Admin title="Could not load" loggedIn>
  <p><a href="/admin/" class="text-deep underline">← Dashboard</a></p>
  <h1 class="mt-3 font-display text-3xl font-bold text-deep">Could not load this page</h1>
  <p role="alert" class="mt-6 rounded border border-[#B42318] bg-white p-3">{message}</p>
</Admin>
