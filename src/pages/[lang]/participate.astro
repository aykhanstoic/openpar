---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { useTranslations, localePath, type Locale } from "../../i18n/ui";

export { getStaticPaths } from "../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const p = t.participate;

const steps = [
  { title: p.step1Title, body: p.step1Body },
  { title: p.step2Title, body: p.step2Body },
  { title: p.step3Title, body: p.step3Body },
  { title: p.step4Title, body: p.step4Body },
  { title: p.step5Title, body: p.step5Body },
];

const audiences = [
  { id: "students", title: p.studentTitle, body: p.studentBody, cta: p.studentCta, href: "sessions", accent: true },
  { id: "schools", title: p.schoolTitle, body: p.schoolBody, cta: p.schoolCta, href: "contact" },
  { id: "parents", title: p.parentTitle, body: p.parentBody, cta: p.parentCta, href: "contact" },
  { id: "officials", title: p.volunteerTitle, body: p.volunteerBody, cta: p.volunteerCta, href: "sessions" },
  { id: "alumni", title: p.alumniTitle, body: p.alumniBody, cta: p.alumniCta, href: "alumni" },
];

const faqs = [
  { q: p.faq1Q, a: p.faq1A },
  { q: p.faq2Q, a: p.faq2A },
  { q: p.faq3Q, a: p.faq3A },
  { q: p.faq4Q, a: p.faq4A },
  { q: p.faq5Q, a: p.faq5A },
];
---

<Base locale={locale} title={p.title} description={p.lead}>
  <PageHero locale={locale} title={p.title} lead={p.lead} />

  <!-- ============================================================= steps -->
  <!-- The plan asks for an "infographic style" page: this is the spine of it,
       a numbered route rendered as a vertical track rather than prose. -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-[54ch]">
        <p class="eyebrow">{p.stepsEyebrow}</p>
        <h2 class="mt-4 text-h2">{p.stepsTitle}</h2>
      </div>

      <ol class="relative mt-12 grid gap-8">
        <!-- Vertical track -->
        <div
          class="absolute bottom-8 left-[23px] top-4 w-px bg-line md:left-[27px]"
          aria-hidden="true"
        >
        </div>

        {
          steps.map((step, i) => (
            <li class="relative grid grid-cols-[48px_1fr] items-start gap-5 md:grid-cols-[56px_1fr] md:gap-7">
              <span class="z-10 grid h-12 w-12 place-items-center rounded-full bg-deep font-display text-[1.05rem] font-bold text-white md:h-14 md:w-14 md:text-[1.2rem]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="pt-1.5 md:pt-3">
                <h3 class="font-display text-[1.15rem] font-bold md:text-[1.3rem]">{step.title}</h3>
                <p class="mt-2 max-w-[58ch] text-[0.96rem] leading-relaxed text-ink-muted">
                  {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========================================================= audiences -->
  <section class="section bg-cream">
    <div class="wrap">
      <div class="max-w-[52ch]">
        <p class="eyebrow">{p.audiencesEyebrow}</p>
        <h2 class="mt-4 text-h2">{p.audiencesTitle}</h2>
      </div>

      <div class="mt-11 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          audiences.map((a) => (
            <article
              id={a.id}
              class:list={[
                "card card-hover justify-between scroll-mt-24 p-7",
                a.accent && "border-deep bg-deep text-white",
              ]}
            >
              <div>
                <h3
                  class:list={[
                    "font-display text-[1.2rem] font-bold",
                    a.accent && "text-white",
                  ]}
                >
                  {a.title}
                </h3>
                <p
                  class:list={[
                    "mt-3 text-[0.94rem] leading-relaxed",
                    a.accent ? "text-white/80" : "text-ink-muted",
                  ]}
                >
                  {a.body}
                </p>
              </div>

              <a
                href={localePath(locale, a.href)}
                class:list={["link-arrow mt-7", a.accent && "text-white"]}
              >
                {a.cta}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =============================================================== faq -->
  <section class="section">
    <div class="wrap-narrow">
      <p class="eyebrow">{p.faqEyebrow}</p>
      <h2 class="mt-4 text-h2">{p.faqTitle}</h2>

      <!-- Native disclosure elements: keyboard-accessible and findable by
           in-page search without any JavaScript. -->
      <div class="mt-9 border-t border-line">
        {
          faqs.map((faq) => (
            <details class="group border-b border-line">
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-[1.02rem] font-semibold hover:text-deep"
              >
                {faq.q}
                <svg
                  class="shrink-0 text-deep transition-transform group-open:rotate-180"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <p class="max-w-[70ch] pb-6 text-[0.95rem] leading-relaxed text-ink-muted">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* Safari still paints the default disclosure marker without this. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
