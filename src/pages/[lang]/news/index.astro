---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { useTranslations, type Locale } from "../../../i18n/ui";

export { getStaticPaths } from "../../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const posts = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/* Resolve related session titles here rather than inside the card, so the
   component stays a pure renderer. */
const sessionTitles = new Map<string, string>();
for (const post of posts) {
  if (!post.data.session) continue;
  const entry = await getEntry(post.data.session);
  if (entry && !entry.data.draft) sessionTitles.set(post.id, entry.data.title);
}

const hasForeign = posts.some((p) => p.data.lang !== locale);
---

<Base locale={locale} title={t.news.title} description={t.news.lead}>
  <PageHero locale={locale} title={t.news.title} lead={t.news.lead} />

  <section class="section">
    <div class="wrap">
      {
        hasForeign && (
          <p class="todo mb-9 max-w-[72ch]">{t.news.otherLanguageNote}</p>
        )
      }

      {
        posts.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <NewsCard post={post} locale={locale} sessionTitle={sessionTitles.get(post.id)} />
            ))}
          </div>
        ) : (
          <p class="max-w-[52ch] text-[1rem] text-ink-muted">{t.news.empty}</p>
        )
      }
    </div>
  </section>
</Base>
