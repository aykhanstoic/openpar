---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { useTranslations, type Locale } from "../../i18n/ui";

export { getStaticPaths } from "../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const lg = t.legal;
---

<Base locale={locale} title={lg.title} description={lg.lead}>
  <PageHero locale={locale} title={lg.title} lead={lg.lead} />

  <section class="section">
    <div class="wrap-narrow">
      <!-- Same loud warning as the privacy skeleton: a stub that reads like a
           real notice is worse than an obviously absent one. -->
      <div class="rounded-card border-2 border-amber bg-amber-050 p-7">
        <h2 class="font-display text-[1.2rem] font-bold text-ink">{lg.warningTitle}</h2>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-[#6B4A10]">{lg.warningBody}</p>
      </div>

      <ol class="mt-12 grid gap-9">
        {
          lg.sections.map((section, i) => (
            <li class="grid grid-cols-[34px_1fr] gap-4">
              <span class="font-display text-[0.85rem] font-bold text-deep">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h2 class="font-display text-[1.12rem] font-bold">{section.title}</h2>
                <p class="mt-2 text-[0.96rem] leading-relaxed text-ink-muted">{section.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
