---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import BoardGrid from "../../../components/BoardGrid.astro";
import { useTranslations, type Locale } from "../../../i18n/ui";

export { getStaticPaths } from "../../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<Base locale={locale} title={t.boards.executiveTitle} description={t.boards.executiveLead}>
  <PageHero
    locale={locale}
    title={t.boards.executiveTitle}
    lead={t.boards.executiveLead}
    parent={{ label: t.nav.about, path: "about" }}
  />

  <section class="section">
    <div class="wrap">
      <BoardGrid locale={locale} body="executive" emptyMessage={t.boards.emptyExecutive} />

    </div>
  </section>
</Base>
