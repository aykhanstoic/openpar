---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import SessionCard from "../../components/SessionCard.astro";
import NewsCard from "../../components/NewsCard.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import Buta from "../../components/Buta.astro";
import { useTranslations, localePath, type Locale } from "../../i18n/ui";

export { getStaticPaths } from "../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/* Next session = the soonest one that has not finished yet, open calls first
   so an open call is never buried under a merely-announced later session. */
const now = new Date();
const upcoming = (await getCollection("sessions", ({ data }) => !data.draft && data.endDate >= now))
  .sort((a, b) => {
    const openA = a.data.status === "call-open" ? 0 : 1;
    const openB = b.data.status === "call-open" ? 0 : 1;
    return openA - openB || a.data.startDate.valueOf() - b.data.startDate.valueOf();
  });
const nextSession = upcoming[0];

const posts = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

/* Resolve related session titles up front — components should not query. */
const sessionTitles = new Map<string, string>();
for (const post of posts) {
  if (!post.data.session) continue;
  const entry = await getEntry(post.data.session);
  if (entry && !entry.data.draft) sessionTitles.set(post.id, entry.data.title);
}

const stats = [
  { value: t.home.numberCountriesValue, label: t.home.numberCountriesLabel },
  { value: t.home.numberFoundedValue, label: t.home.numberFoundedLabel },
  { value: t.home.numberAgeValue, label: t.home.numberAgeLabel },
  { value: t.home.numberVolunteerValue, label: t.home.numberVolunteerLabel },
];
---

<Base locale={locale} title={t.nav.home} bareTitle>
  <!-- ================================================================ hero -->
  <!-- EYP template hero (eype.es / eyp.pt): indigo headline on a slanted
       pale-blue band, stacked-button CTA, next session as a white card. -->
  <section class="slant overflow-hidden">
    <!-- Buta watermark, white on the pale band, behind the session card -->
    <Buta
      class="pointer-events-none absolute left-[31%] top-[2%] -z-[1] hidden h-[90%] w-auto -scale-x-100 -rotate-[12deg] text-white md:block"
      stroke={1.6}
    />
    <div class="wrap grid gap-12 pb-24 pt-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16 lg:pb-40 lg:pt-20">
      <div>
        <h1 class="text-hero leading-[1.02] text-deep">
          {t.home.title}<br />{t.home.titleAccent}
        </h1>

        <p class="mt-7 max-w-[44ch] text-[1.15rem] leading-relaxed text-ink lg:text-[1.3rem]">
          {t.home.lead}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
          <a href={localePath(locale, "participate")} class="btn btn-primary btn-lg">
            {t.home.ctaPrimary}
          </a>
          <a href={localePath(locale, "what-is-eyp")} class="link-underline">
            {t.home.ctaSecondary}
          </a>
        </div>
      </div>

      <div>
        <p class="eyebrow mb-4">{t.home.nextSessionLabel}</p>
        {
          nextSession ? (
            <SessionCard session={nextSession} locale={locale} />
          ) : (
            <div class="card p-7">
              <p class="leading-relaxed text-ink-muted">{t.home.nextSessionNone}</p>
              <a href={localePath(locale, "sessions")} class="link-arrow mt-5">
                {t.nav.sessions}
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== stats -->
  <!-- "Facts and figures" as in the reference: open columns, no boxes. -->
  <section class="section-sm">
    <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-[2.6rem] font-extrabold leading-none tracking-tight text-deep lg:text-[3.2rem]">
              {s.value}
            </p>
            <div class="rule-amber mt-4"></div>
            <p class="mt-3 max-w-[24ch] leading-snug text-ink">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- =========================================================== what EYP -->
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="eyebrow">{t.home.whatEyebrow}</p>
        <h2 class="mt-4 text-h2">{t.home.whatTitle}</h2>
        <div class="rule-amber mt-6"></div>
      </div>

      <div class="grid gap-6">
        <p class="text-[1.05rem] leading-relaxed">{t.home.whatBody1}</p>
        <p class="text-[1.05rem] leading-relaxed">{t.home.whatBody2}</p>
        <p class="text-[1.05rem] leading-relaxed">{t.home.whatBody3}</p>
        <a href={localePath(locale, "what-is-eyp")} class="link-arrow mt-1">
          {t.home.whatCta}
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================= routes -->
  <section class="section bg-cream">
    <div class="wrap">
      <div class="max-w-[52ch]">
        <p class="eyebrow">{t.home.routesEyebrow}</p>
        <h2 class="mt-4 text-h2">{t.home.routesTitle}</h2>
      </div>

      <div class="mt-11 grid gap-6 md:grid-cols-2">
        <article class="card card-hover justify-between p-8">
          <div>
            <span
              class="grid h-11 w-11 place-items-center bg-deep-050 text-deep"
              aria-hidden="true"
            >
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" /><path d="M9.6 9.4a2.5 2.5 0 1 1 3.3 2.4c-.6.2-.9.8-.9 1.4v.3" /><path d="M12 17.2h.01" />
              </svg>
            </span>
            <h3 class="mt-5 text-h3">{t.home.routeNewTitle}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-muted">
              {t.home.routeNewBody}
            </p>
          </div>
          <a href={localePath(locale, "what-is-eyp")} class="link-arrow mt-7">
            {t.home.routeNewCta}
          </a>
        </article>

        <article class="card card-hover justify-between p-8">
          <div>
            <span
              class="grid h-11 w-11 place-items-center bg-sun text-ink"
              aria-hidden="true"
            >
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H19v13H5.5A1.5 1.5 0 0 0 4 18.5z" /><path d="M4 18.5A1.5 1.5 0 0 1 5.5 17H19v3H5.5A1.5 1.5 0 0 1 4 18.5z" /><path d="M8.5 8.5h6" />
              </svg>
            </span>
            <h3 class="mt-5 text-h3">{t.home.routeMemberTitle}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-muted">
              {t.home.routeMemberBody}
            </p>
          </div>
          <a href={localePath(locale, "sessions")} class="link-arrow mt-7">
            {t.home.routeMemberCta}
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================ gallery -->
  <!-- Marked slots for the launch photo set (plan: photo-rich design). -->
  <section class="section">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{t.home.galleryEyebrow}</p>
          <h2 class="mt-4 text-h2">{t.home.galleryTitle}</h2>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
        <PhotoPlaceholder label={t.common.photoPlaceholder} class="aspect-[4/3]" />
        <PhotoPlaceholder label={t.common.photoPlaceholder} class="aspect-[4/3]" />
        <PhotoPlaceholder label={t.common.photoPlaceholder} class="aspect-[4/3]" />
        <PhotoPlaceholder label={t.common.photoPlaceholder} class="aspect-[4/3]" />
      </div>

      <p class="todo mt-8 max-w-[80ch]">
        <strong>{t.common.placeholderNotice}.</strong> {t.home.galleryNote}
      </p>
    </div>
  </section>

  <!-- =============================================================== news -->
  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">{t.home.newsEyebrow}</p>
              <h2 class="mt-4 text-h2">{t.home.newsTitle}</h2>
            </div>
            <a href={localePath(locale, "news")} class="link-arrow">
              {t.common.seeAll}
            </a>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <NewsCard post={post} locale={locale} sessionTitle={sessionTitles.get(post.id)} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
