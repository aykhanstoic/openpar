---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { useTranslations, localePath, type Locale } from "../../i18n/ui";

export { getStaticPaths } from "../../i18n/paths";

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const al = t.alumni;

const ways = [
  { title: al.way1Title, body: al.way1Body },
  { title: al.way2Title, body: al.way2Body },
  { title: al.way3Title, body: al.way3Body },
  { title: al.way4Title, body: al.way4Body },
];
---

<Base locale={locale} title={al.title} description={al.lead}>
  <PageHero locale={locale} title={al.title} lead={al.lead} />

  <section class="section">
    <div class="wrap">
      <div class="max-w-[52ch]">
        <p class="eyebrow">{al.waysEyebrow}</p>
        <h2 class="mt-4 text-h2">{al.waysTitle}</h2>
      </div>

      <div class="mt-11 grid gap-6 md:grid-cols-2">
        {
          ways.map((way, i) => (
            <article class="card p-7">
              <span class="font-display text-[0.78rem] font-bold text-amber-700">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 font-display text-[1.15rem] font-bold">{way.title}</h3>
              <p class="mt-2.5 text-[0.94rem] leading-relaxed text-ink-muted">{way.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <h2 class="text-h2">{al.testimonialsTitle}</h2>
        <p class="mt-4 max-w-[52ch] text-[1rem] leading-relaxed text-ink-muted">
          {al.testimonialsBody}
        </p>
        <p class="todo mt-6 max-w-[60ch]">
          <strong>{t.common.placeholderNotice}.</strong> Testimonials carry weight with parents and
          schools, but only with a real name, session and year attached. Invented ones are worse
          than none.
        </p>
      </div>

      <div class="card border-deep bg-deep p-9 text-white">
        <h2 class="text-h3 text-white">{al.ctaTitle}</h2>
        <p class="mt-3 max-w-[42ch] text-[0.96rem] leading-relaxed text-white/80">{al.ctaBody}</p>
        <a href={localePath(locale, "contact")} class="btn btn-on-dark mt-7 self-start">
          {al.ctaButton}
        </a>
      </div>
    </div>
  </section>
</Base>
