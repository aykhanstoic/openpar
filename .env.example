# /admin editor. Set these in Vercel (Project > Settings > Environment Variables),
# or in a local .env to try the editor with `npm run dev`.

# The one shared password editors type in. At least 12 characters.
ADMIN_PASSWORD=
# Random string, at least 32 characters, used to sign the login cookie.
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token: only this repo, permission "Contents: Read and write".
# Leave it out locally: `npm run dev` then saves to the files on this computer.
GITHUB_TOKEN=
# Defaults: aykhanstoic/openpar and dev. The branch must be the one Vercel deploys.
GITHUB_REPO=
GITHUB_BRANCH=
